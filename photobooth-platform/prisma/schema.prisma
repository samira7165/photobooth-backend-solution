generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── ADMIN USERS ───

enum Role {
  SUPER_ADMIN
  ADMIN
  OPERATOR
  VIEWER
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          Role      @default(OPERATOR)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  auditLogs     AuditLog[]

  @@map("users")
}

// ─── CAMPAIGNS ───

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

model Campaign {
  id              String          @id @default(uuid())
  slug            String          @unique
  name            String
  status          CampaignStatus  @default(DRAFT)

  // Processing mode
  processingMode  String          @default("non-ai") // "ai", "non-ai", "both"

  // All config as flexible JSON
  brandConfig     Json?           // { logo, primaryColor, secondaryColor, backgroundColor, fontFamily }
  // { provider, model, prompt, strength, fallbackProviders, allowCustomPrompt, referenceImage, aiBackgroundGeneration, aiBackgroundPrompt,
  //   promptMode: "template" (default, unset behaves the same) | "prompt-option" | "both" — see the PromptOption model comment
  //   customInput: { enabled, label, maxLength, promptTemplate } — an optional campaign-level "Other" choice alongside
  //     PromptOption rows, only meaningful when promptMode is "prompt-option"/"both". promptTemplate contains a literal
  //     "{user_input}" placeholder substituted with the booth user's typed text (see common/utils/custom-prompt.util.ts).
  //     promptTemplate is internal generation detail, same as PromptOption.prompt — never sent to a booth-facing endpoint. }
  aiConfig        Json?
  photoSettings   Json?           // { orientation, outputWidth, outputHeight }
  backgroundConfig Json?          // { removal, allowCustomUpload, defaultBackgroundId }
  frameConfig     Json?           // { enabled, defaultFrameId }
  propConfig      Json?           // { enabled }
  qrConfig        Json?           // { enabled, position: {x,y}, size, contentType, customContent, embedInImage }
  // Superset of qrConfig above, covering every delivery method at once:
  // { qrCode: {enabled, position, size, contentType, customContent, embedInImage},
  //   shortCode: {enabled, prefix, codeLength},
  //   directLink: {enabled, expiryHours},
  //   print: {enabled, format, copies} }
  // Null on every campaign created before this existed — DeliveryService
  // resolves the effective config by falling back to qrConfig (folded into
  // deliveryConfig.qrCode) whenever this is null, so old campaigns keep
  // behaving exactly as before (QR only, no shortCode/directLink surfaced,
  // codes never expire). print.enabled is stored/exposed only — there is no
  // physical printer integration anywhere in this codebase to actually act
  // on it (see the print-tracking PrintStatus enum comment above).
  deliveryConfig  Json?
  textConfig      Json?           // { enabled, content, position: {x,y}, font, color, size, allowCustomText }
  collectFields   Json            @default("[\"name\", \"phone\"]") // which user info fields to collect
  outputMode      String          @default("qr") // "qr", "download", "print", "sms", "email"

  // Origins allowed to call this campaign's /api/v1/public/* endpoints when
  // a DeveloperApiKey doesn't set its own allowedOrigins — a per-campaign
  // fallback so most keys on one campaign don't need to repeat the same list.
  allowedOrigins  Json?           // string[] of origins, e.g. ["https://acme.com"]

  // Schedule & Limits
  startDate       DateTime?
  endDate         DateTime?
  maxSubmissions  Int?
  dailyBudget     Float?
  totalBudget     Float?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  submissions     Submission[]
  backgrounds     Background[]
  frames          Frame[]
  props           Prop[]
  templates       Template[]
  promptOptions   PromptOption[]
  apiKeyLinks     CampaignApiKey[]
  developerApiKeys DeveloperApiKey[]

  @@index([slug])
  @@index([status])
  @@map("campaigns")
}

// ─── BACKGROUNDS ───

model Background {
  id            String    @id @default(uuid())
  campaignId    String
  name          String
  imageUrl      String    // S3 key
  thumbnailUrl  String?   // S3 key for preview
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  campaign      Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("backgrounds")
}

// ─── FRAMES ───

model Frame {
  id            String    @id @default(uuid())
  campaignId    String
  name          String
  imageUrl      String    // S3 key (PNG with transparency)
  thumbnailUrl  String?
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  campaign      Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("frames")
}

// ─── PROPS ───

enum PropPosition {
  HEAD_TOP      // hat, crown, tiara
  FACE_EYES     // glasses, sunglasses
  FACE_FULL     // mask
  HEAD_HAIR     // wig
  BODY_NECK     // necklace, bow tie
  HAND_HELD     // sign, board
}

model Prop {
  id            String        @id @default(uuid())
  campaignId    String
  name          String
  imageUrl      String        // S3 key (PNG with transparency)
  thumbnailUrl  String?
  positionType  PropPosition  @default(HEAD_TOP)
  sortOrder     Int           @default(0)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())

  campaign      Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("props")
}

// ─── AI TEMPLATES ───
// A booth-selectable "style" for AI mode (e.g. "Classic Spiderman suit" vs
// "Miles Morales suit") — the booth shows these like backgrounds/frames/
// props, and the chosen one's image is sent to the AI provider alongside
// the user's photo as a style reference. `prompt` is optional: if every
// template on a campaign leaves it blank, the campaign's aiConfig.prompt
// is used for all of them; a template with its own prompt overrides that
// campaign default for just that one.

model Template {
  id            String    @id @default(uuid())
  campaignId    String
  name          String
  imageUrl      String    // S3 key — sent to the AI provider as a reference image
  thumbnailUrl  String?   // S3 key for the booth-facing preview
  prompt        String?   @db.Text
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  campaign      Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("templates")
}

// ─── PROMPT OPTIONS ───
// A booth-selectable text prompt for campaigns that don't use a reference-
// image Template (aiConfig.promptMode "prompt-option" or "both" — see the
// promptMode comment on Campaign.aiConfig). The booth shows these like
// templates/backgrounds, but picking one sends ONLY the user's own photo to
// the AI provider — no second reference image — along with this row's
// `prompt` text. That text is internal generation detail and must never be
// returned by a booth-facing endpoint (see CampaignsService.getBoothConfig).

model PromptOption {
  id           String   @id @default(uuid())
  campaignId   String
  name         String   // "Doctor", "Astronaut" — what the user sees on screen
  description  String?  // optional short description shown below the name
  prompt       String   @db.Text // the full AI prompt sent to the provider
  thumbnailUrl String?  // optional preview image shown on the booth selection screen
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  submissions  Submission[]

  @@index([campaignId])
  @@map("prompt_options")
}

// ─── SUBMISSIONS ───

enum SubmissionStatus {
  UPLOADED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

// Tracks a physical print of a submission's result, independent of
// SubmissionStatus (a submission is COMPLETED long before/regardless of
// whether it's ever printed — same relationship downloadCode/downloadCount
// below have to status). PRINTING exists for a future real printer-hardware
// integration to report through; today there is none (see the comment on
// SubmissionsService.print()), so the only transitions actually exercised
// are NOT_PRINTED/FAILED -> PRINT_REQUESTED -> PRINTED.
enum PrintStatus {
  NOT_PRINTED
  PRINT_REQUESTED
  PRINTING
  PRINTED
  FAILED
}

model Submission {
  id              String            @id @default(uuid())
  campaignId      String

  // User info (depends on campaign collectFields)
  userName        String?
  userEmail       String?
  userPhone       String?
  sessionId       String?

  // Photos
  originalUrl     String            // S3 key for uploaded photo
  resultUrl       String?           // S3 key for processed photo
  thumbnailUrl    String?           // S3 key for thumbnail

  // Processing
  status          SubmissionStatus  @default(UPLOADED)
  mode            String            @default("non-ai") // "ai" or "non-ai"
  backgroundUsed  String?           // background ID or "custom" or "ai-generated"
  frameUsed       String?           // frame ID or null
  propsUsed       Json?             // array of prop IDs used
  templateUsed    String?           // Template ID (AI reference image + style prompt), or null
  promptOptionId  String?           // PromptOption ID the user picked (no-reference-image mode), or null
  // Raw text the user typed for the campaign-level "Other" custom-input
  // option (aiConfig.customInput — see the field comment on Campaign.aiConfig),
  // mutually exclusive with promptOptionId. The resolved prompt (template with
  // {user_input} substituted) is NOT stored separately from promptUsed below —
  // this column is only the user's raw input, for admin visibility/audit.
  customInput     String?           @db.Text
  orientation     String?           // "portrait" or "landscape"

  // AI specific
  styleUsed       String?
  promptUsed      String?           @db.Text
  aiProvider      String?
  aiModel         String?
  apiKeyUsed      String?           // key identifier (NOT actual key)
  tokensUsed      Int?
  costEstimate    Float?
  referenceImageUrl String?         // the used Template's image URL, sent to the AI provider alongside the booth photo

  // Job tracking
  processingTime  Int?              // milliseconds
  retryCount      Int               @default(0)
  errorMessage    String?           @db.Text

  // Output
  qrCodeUrl       String?
  downloadCode    String?           @unique // raw lookup key, e.g. "4K7X" — never includes the campaign's shortCode prefix
  displayCode     String?           // what the user sees/types, e.g. "DREAM-4K7X" (== downloadCode when the campaign has no prefix configured)
  downloadCodeExpiresAt DateTime?   // null = never expires (matches every campaign that predates deliveryConfig.directLink.expiryHours)
  downloadCount   Int               @default(0)

  // Print tracking — see the PrintStatus comment above. A NOT NULL column
  // with a default backfills every pre-existing row to NOT_PRINTED on
  // migration, so historical submissions are never mistakenly reported as
  // already printed.
  printStatus     PrintStatus       @default(NOT_PRINTED)
  printedAt       DateTime?
  printerId       String?           // optional booth/printer identifier, if the caller sends one
  printAttempts   Int               @default(0)
  printError      String?           @db.Text

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  campaign        Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // SetNull (not the schema-wide default) deliberately, unlike Campaign's
  // cascade above — deleting a PromptOption must never delete or block
  // deletion of the submission history that used it; it should just forget
  // which option it was.
  promptOption    PromptOption?     @relation(fields: [promptOptionId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([status])
  @@index([printStatus])
  @@index([createdAt])
  @@index([promptOptionId])
  // No separate @@index([downloadCode]) — @unique above already creates one.
  @@map("submissions")
}

// ─── AI PROVIDERS ───

model AiProvider {
  id              String    @id @default(uuid())
  name            String    @unique // "gemini", "dalle", "replicate"
  baseUrl         String
  isHealthy       Boolean   @default(true)
  lastHealthCheck DateTime?
  avgResponseTime Int?      // milliseconds
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  apiKeys         ApiKey[]

  @@map("ai_providers")
}

// ─── API KEYS ───

model ApiKey {
  id              String    @id @default(uuid())
  providerId      String
  keyIdentifier   String    // human-readable: "gemini-key-1"
  encryptedKey    String    @db.Text // actual API key (encrypt in production)
  isActive        Boolean   @default(true)
  usageToday      Int       @default(0)
  usageTotal      Int       @default(0)
  lastUsedAt      DateTime?
  errorCount      Int       @default(0)
  lastErrorAt     DateTime?
  dailyLimit      Int?      // max requests per day
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  provider        AiProvider     @relation(fields: [providerId], references: [id])
  campaignLinks   CampaignApiKey[]
  usageLogs       ApiKeyUsageLog[]
  models          ApiKeyModel[]

  @@index([providerId])
  @@map("api_keys")
}

// ─── API KEY MODELS ───
// One physical key can call multiple models of the same provider (e.g. a
// single Gemini key calling both gemini-2.5-flash-image and
// gemini-3-pro-image) — the secret lives once on ApiKey, model names live
// here so a campaign's failover chain can pick "this key, this model"
// without re-storing the secret per model.

model ApiKeyModel {
  id        String   @id @default(uuid())
  apiKeyId  String
  model     String
  createdAt DateTime @default(now())

  apiKey    ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@unique([apiKeyId, model])
  @@index([apiKeyId])
  @@map("api_key_models")
}

// ─── API KEY USAGE LOG ───
// One row per recordKeyUsage() call — the real per-call history that
// ApiKey's usageToday/errorCount/lastUsedAt/lastErrorAt counters summarize.

model ApiKeyUsageLog {
  id            String    @id @default(uuid())
  apiKeyId      String
  success       Boolean
  responseTime  Int?      // milliseconds
  errorMessage  String?   @db.Text
  createdAt     DateTime  @default(now())

  apiKey        ApiKey    @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId])
  @@index([createdAt])
  @@map("api_key_usage_logs")
}

// ─── CAMPAIGN-API KEY LINKS ───
// null campaignId = shared key available to all campaigns

model CampaignApiKey {
  id          String    @id @default(uuid())
  campaignId  String?
  apiKeyId    String

  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  apiKey      ApiKey    @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@unique([campaignId, apiKeyId])
  @@map("campaign_api_keys")
}

// ─── DEVELOPER API KEYS ───
// External-developer access to a campaign's public booth endpoints
// (/api/v1/public/*) — unrelated to the ApiKey model above, which stores AI
// provider secrets (Gemini/OpenAI). Do not confuse the two.

model DeveloperApiKey {
  id              String    @id @default(uuid())
  campaignId      String
  name            String    // human label, e.g. "Acme Corp Production Key"

  // The raw key ("pb_live_..."/"pb_test_...") is shown to the admin exactly
  // once at creation and never stored. keyPrefix (enough of the raw key to
  // find candidate rows without a full-table scan) is kept in plaintext for
  // admin-UI display and lookup; keyHash (bcrypt) is what's actually
  // verified against on every request.
  keyPrefix       String
  keyHash         String    @db.Text

  isActive        Boolean   @default(true)
  // string[] of allowed origins for this specific key; falls back to
  // campaign.allowedOrigins when null.
  allowedOrigins  Json?
  rateLimit       Int       @default(60) // requests per minute

  usageToday      Int       @default(0)
  usageTotal      Int       @default(0)
  lastUsedAt      DateTime?
  expiresAt       DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  campaign        Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([keyPrefix])
  @@map("developer_api_keys")
}

// ─── AUDIT LOG ───

model AuditLog {
  id          String    @id @default(uuid())
  userId      String
  action      String    // "campaign.created", "campaign.updated", "user.login"
  entityType  String?   // "campaign", "user", "submission"
  entityId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
