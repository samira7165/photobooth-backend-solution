FROM node:20-alpine AS builder
WORKDIR /app
# Must match the production stage's OpenSSL presence below — see Dockerfile's
# matching comment for why a mismatch breaks the Query Engine at runtime.
RUN apk add --no-cache openssl
COPY package*.json ./
RUN npm ci
COPY . .
RUN npx prisma generate
RUN npm run build

FROM node:20-alpine AS production
WORKDIR /app
# See Dockerfile's matching comment — Prisma needs OpenSSL present to detect
# the right engine binary target instead of falling back to a guess.
RUN apk add --no-cache openssl
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./
COPY --from=builder /app/prisma ./prisma
RUN chown -R appuser:appgroup /app

ENV NODE_ENV=production
USER appuser
# No EXPOSE — this process only consumes BullMQ jobs, it never listens on a
# port. `prisma migrate deploy` is safe to run from both this and the api
# container at once (Prisma takes an advisory lock on the migrations table),
# so whichever of the two starts first just wins the race harmlessly.
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/worker.main"]
