PORT=3000
NODE_ENV=development
DATABASE_URL="mysql://user:password@localhost:3306/photobooth"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_SECRET=change-this-in-production
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-aws-access-key-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-key-here
S3_BUCKET=your-s3-bucket-name
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
REPLICATE_API_KEY=your-replicate-api-key-here
REMOVE_BG_API_KEY=your-remove-bg-api-key
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_TTL=900
LOGIN_RATE_LIMIT_MAX=5
UPLOAD_RATE_LIMIT_TTL=60
UPLOAD_RATE_LIMIT_MAX=10
MAX_FILE_SIZE=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
FRONTEND_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002
PUBLIC_API_URL=http://localhost:3000/api/v1/public

# Comma-separated list of additional origins allowed to call the admin/booth
# API (beyond localhost + FRONTEND_URL/ADMIN_URL above) — e.g. a client's own
# booth frontend domain in production. See src/main.ts's CORS setup.
ALLOWED_ORIGINS=https://booth1.example.com,https://booth2.example.com
